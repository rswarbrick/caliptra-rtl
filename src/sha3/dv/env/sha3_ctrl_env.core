name: "lowrisc:dv:sha3_ctrl_env:0.1"
description: "sha3_ctrl DV UVM environment"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_lib
      - lowrisc:dv:str_utils
      - lowrisc:dv:test_vectors
      - lowrisc:dv:digestpp_dpi:0.1
      - caliptra:compile_yml:sha3_ctrl
      - lowrisc:dv:ahb_agent
      - caliptra:dv:sha3_ctrl_ral
    files:
      - sha3_ctrl_env_pkg.sv
      - sha3_intr_if.sv
      - sha3_ctrl_env_cfg.sv: {is_include_file: true}
      - sha3_ctrl_env_cov.sv: {is_include_file: true}
      - sha3_ctrl_virtual_sequencer.sv: {is_include_file: true}
      - sha3_ctrl_scoreboard.sv: {is_include_file: true}
      - sha3_ctrl_env.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_vseq_list.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_base_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_smoke_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_long_msg_and_output_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_test_vectors_base_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_test_vectors_sha3_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_test_vectors_shake_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_burst_write_vseq.sv: {is_include_file: true}
      - seq_lib/sha3_ctrl_stress_all_vseq.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
