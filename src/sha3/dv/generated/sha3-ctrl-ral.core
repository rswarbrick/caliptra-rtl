name: "caliptra:dv:sha3_ctrl_ral:0.1"
description: "UVM register model for sha3_ctrl"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_base_reg
    files:
      - sha3_ctrl_dv_reg_sample.svh: {is_include_file: true}
      - sha3_ctrl_dv_reg_covergroups.svh: {is_include_file: true}
      - sha3_ctrl_dv_reg_uvm.sv
    file_type: systemVerilogSource

targets:
  default:
    toplevel: tb
    filesets:
      - files_dv
    default_tool: vcs
