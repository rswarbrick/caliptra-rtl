name: "lowrisc:dv:sha3_ctrl_sim:0.1"
description: "SHA3_CTRL DV sim target"
filesets:
  files_rtl:
    depend:
      - caliptra:compile_yml:kmac

  files_dv:
    depend:
      - lowrisc:dv:sha3_ctrl_test
      - lowrisc:dv:kmac_cov
    files:
      - tb.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    default_tool: vcs

  lint:
    <<: *sim_target
