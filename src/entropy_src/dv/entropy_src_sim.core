name: "lowrisc:dv:entropy_src_sim:0.1"
description: "ENTROPY_SRC DV sim target"
filesets:
  files_rtl:
    depend:
      - caliptra:compile_yml:entropy_src

  files_dv:
    depend:
      - lowrisc:dv:entropy_src_test
      - lowrisc:dv:digestpp_dpi:0.1
    files:
      - tb/tb.sv
      - tb/entropy_src_tb_assertion_if.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    default_tool: vcs

  lint:
    <<: *sim_target
