name: "lowrisc:dv:aes_sva:0.1"
description: "AES assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - caliptra:compile_yml:aes
    files:
      - aes_bind.sv
      - aes_idle_check.sv
      - aes_reseed_if.sv
      - aes_masking_reseed_if.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_dv
