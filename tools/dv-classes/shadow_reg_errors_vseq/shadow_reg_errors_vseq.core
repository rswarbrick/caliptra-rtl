name: "lowrisc:dv:shadow_reg_errors_vseq:0.1"
description: "Virtual sequence to check shadow registers report errors correctly"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_base_reg
      - lowrisc:dv:csr_utils
    files:
      - shadow_reg_errors_vseq_pkg.sv
      - shadow_reg_errors_vseq.svh: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
