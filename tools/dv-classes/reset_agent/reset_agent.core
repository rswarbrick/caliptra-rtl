name: "lowrisc:dv:reset_agent:0.1"
description: "Reset agent"
filesets:
  files_dv:
    files:
      - reset_if.sv
      - reset_agent_pkg.sv

      - reset_drive_item.svh: {is_include_file: true}
      - reset_driver.svh: {is_include_file: true}

      - reset_edge_item.svh: {is_include_file: true}
      - reset_monitor.svh: {is_include_file: true}

      - reset_agent.svh: {is_include_file: true}

      - seq_lib/reset_seq.svh: {is_include_file: true}
      - seq_lib/reset_now_seq.svh: {is_include_file: true}
      - seq_lib/random_reset_seq.svh: {is_include_file: true}

    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
