name: "lowrisc:dv:ahb_mem_rw_seq:0.1"
description: "Sequence to write and read a memory over AHB"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_utils
      - lowrisc:dv:ahb_agent
    files:
      - ahb_mem_rw_seq_pkg.sv
      - ahb_mem_rw_seq.svh: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
