name: "lowrisc:dv:ahb_same_csr_outstanding_vseq:0.1"
description: "Virtual sequence to send back-to-back reads and writes of CSRs over AHB"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_lib
    files:
      - ahb_same_csr_outstanding_vseq_pkg.sv
      - ahb_one_csr_outstanding_vseq.svh: {is_include_file: true}
      - ahb_same_csr_outstanding_vseq.svh: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
