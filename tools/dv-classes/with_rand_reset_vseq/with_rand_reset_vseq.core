name: "lowrisc:dv:with_rand_reset_vseq:0.1"
description: "Virtual sequence that watches a sequence running and asserts a reset in the middle."
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_lib
      - lowrisc:dv:reset_agent
    files:
      - with_rand_reset_vseq_pkg.sv
      - with_rand_reset_vseq.svh: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
